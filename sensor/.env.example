# Backend (Express + Socket.IO)
BACKEND_URL=http://localhost:3000

# Käytettävissä olevat kamerat
CAMERA_INDICES=0,2

# Kameran indeksi (camera-haarassa Brio = 1, main = 0)
CAMERA_INDEX=0

# Kuinka usein sensor:update lähetetään (sekunteina)
SEND_INTERVAL_SEC=1.0

# YOLO-malli
MODEL_PATH=yolov8n.pt

# Kameroiden päällekkäisten havaintojen yhdistämisetäisyys (kartan yksiköissä)
MERGE_DISTANCE=35